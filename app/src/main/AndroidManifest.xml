<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Transfers move bytes between two cloud providers over HTTPS (spec §1). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- §16 needs to know whether the current network is metered. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".app.CloudLugApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudLug">

        <!--
          AppAuth declares this activity, with the intent-filter that claims
          ${appAuthRedirectScheme}; tools:node="merge" adds a theme to that
          declaration without restating it. Its own theme has to be an
          AppCompat one — see Theme.CloudLug.OAuthRedirect for why, and for
          what happened without it.
        -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:theme="@style/Theme.CloudLug.OAuthRedirect"
            tools:node="merge" />

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CloudLug">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
