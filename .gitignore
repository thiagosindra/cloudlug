# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
local.properties

# Android (v0.2 onward — see docs/decisions.md ADR-0003)
*.apk
*.aab
*.ap_
*.dex
*.class
captures/
.externalNativeBuild/
.cxx/
# AGP's legacy signed-output directory. Anchored to a module root, because an
# unanchored `release/` also matches `app/src/release/` — a variant source set.
# It did, silently: `git add -A` skipped the release-variant crash reporter, the
# local build kept working from the untracked file, and only a clean CI checkout
# failed. Modern AGP writes outputs under `build/`, which is ignored above.
/*/release/
output.json

# Signing material and provider credentials must never be committed (spec §30)
*.jks
*.keystore
keystore.properties
# The one exception, and it is deliberate: the debug key is committed so that
# every contributor and CI produce the same certificate SHA-1, which is what a
# Google OAuth client for Android is registered against. It signs debug builds
# only. See docs/oauth.md.
!app/debug.keystore
google-services.json
secrets.properties

# IDE
.idea/
*.iml
*.ipr
*.iws
.kotlin/
out/

# OS
.DS_Store
Thumbs.db
