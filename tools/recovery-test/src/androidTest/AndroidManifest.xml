<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Package visibility (API 30+). AGP generates a <queries> block listing the
      test services and nothing else, so without this the harness cannot see
      CloudLug at all: launching it fails and UiAutomator reports an empty
      screen rather than saying why. Declaring the package under test is not
      optional once the test lives outside it.
    -->
    <queries>
        <package android:name="dev.thiagosindra.cloudlug" />
    </queries>

</manifest>
